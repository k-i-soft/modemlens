{
  "id": "quectel-ec200a",
  "label": "Quectel EC200A",
  "verified": false,
  "match": {
    "usb": [
      "2c7c:6005"
    ],
    "modelPattern": "EC200A"
  },
  "usb": {
    "atInterface": 3,
    "avoidInterfaces": [
      2,
      4
    ]
  },
  "commands": [
    {
      "id": "qccid",
      "command": "AT+QCCID",
      "category": "sim",
      "phase": "auto",
      "needsSim": true,
      "parser": "qccid"
    },
    {
      "id": "qspn",
      "command": "AT+QSPN",
      "category": "network",
      "phase": "auto",
      "needsSim": true,
      "parser": "qspn"
    },
    {
      "id": "qnwinfo",
      "command": "AT+QNWINFO",
      "category": "network",
      "phase": "auto",
      "parser": "qnwinfo"
    },
    {
      "id": "qeng-serving",
      "command": "AT+QENG=\"servingcell\"",
      "category": "signal",
      "phase": "auto",
      "parser": "qeng_serving"
    },
    {
      "id": "qeng-neighbour",
      "command": "AT+QENG=\"neighbourcell\"",
      "category": "signal",
      "phase": "auto"
    },
    {
      "id": "qcsq",
      "command": "AT+QCSQ",
      "category": "signal",
      "phase": "auto",
      "parser": "qcsq"
    },
    {
      "id": "qtemp",
      "command": "AT+QTEMP",
      "category": "other",
      "phase": "auto",
      "parser": "qtemp"
    },
    {
      "id": "qcfg-usbnet",
      "command": "AT+QCFG=\"usbnet\"",
      "category": "usbmode",
      "phase": "auto",
      "parser": "qcfg"
    },
    {
      "id": "qcfg-band",
      "command": "AT+QCFG=\"band\"",
      "category": "bands",
      "phase": "auto",
      "parser": "qcfg"
    },
    {
      "id": "qpinc",
      "command": "AT+QPINC?",
      "category": "locks",
      "phase": "auto",
      "needsSim": true
    },
    {
      "id": "qgmr",
      "command": "AT+QGMR",
      "category": "identity",
      "phase": "auto"
    }
  ],
  "denyCommands": [
    "+QPRTPARA",
    "+QNVW",
    "+QNVFW",
    "+QCOPS",
    "+QMGDA",
    "+QCMGS",
    "+QCMGR",
    "+QHUP",
    "+QIACT",
    "+QIDEACT"
  ]
}
